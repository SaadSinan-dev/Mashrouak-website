{
  "name": "mashrouak.net",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/security-headers.mjs dist",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint src tests vite.config.ts scripts admin-dashboard/src backend/src shared",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "dev:admin": "npm run dev -w @mashrouak/admin",
    "dev:api": "npm run dev -w @mashrouak/backend",
    "dev:platform": "node scripts/dev-platform.mjs",
    "setup:local": "npm run db:migrate -w @mashrouak/backend && npm run db:seed -w @mashrouak/backend",
    "build:all": "npm run build && npm run build -w @mashrouak/admin && npm run build -w @mashrouak/backend",
    "typecheck:all": "npm run typecheck && npm run typecheck -w @mashrouak/admin && npm run typecheck -w @mashrouak/backend",
    "test:integration": "npm run build -w @mashrouak/backend && tsx tests/platform.integration.ts",
    "test:media:browser": "npm run build -w @mashrouak/backend && tsx tests/cloudinary.browser.runner.mjs",
    "test:publishing:browser": "tsx tests/publishing.browser.runner.mjs",
    "test:publishing": "tsx tests/publishing.integration.ts",
    "test:visual:browser": "tsx tests/visual.browser.runner.mjs",
    "test:devices:browser": "tsx tests/devices.browser.runner.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.66.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.58.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "lighthouse": "^13.0.0",
    "miniflare": "^5.20261104.0-beta",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.0.8"
  },
  "workspaces": [
    "admin-dashboard",
    "backend",
    "shared"
  ]
}
