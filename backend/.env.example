# Server-only settings. Never use VITE_ for these values.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://mashrouak:replace_with_local_password@127.0.0.1:5432/mashrouak
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
SITE_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=mashrouak
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
CHAT_RETENTION_DAYS=90
# Production Pages proxy only: same random server secret in both Pages projects.
PAGES_PROXY_SECRET=
# Optional direct endpoint, used for session notifications and administrative scripts.
# For Neon: use freshly rotated credentials and a direct URL here; runtime DATABASE_URL may be pooled.
DIRECT_DATABASE_URL=
