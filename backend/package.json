{
  "name": "@mashrouak/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate-postgres.ts",
    "db:seed": "tsx scripts/seed-postgres.ts",
    "admin:create": "tsx scripts/provision.ts",
    "db:backup": "tsx scripts/backup-postgres.ts",
    "media:audit": "tsx scripts/migrate-media.ts",
    "media:migrate": "tsx scripts/migrate-media.ts --apply",
    "start": "node dist/server.js",
    "db:migrate:production": "node dist/migrate.js",
    "db:export:d1": "tsx scripts/d1-export.ts",
    "db:import:d1": "tsx scripts/d1-import.ts",
    "content:audit-services": "tsx scripts/audit-services.ts",
    "db:check": "tsx scripts/check-database.ts",
    "test:neon": "cd .. && tsx tests/neon.integration.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@mashrouak/shared": "1.0.0",
    "hono": "^4.10.3",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
