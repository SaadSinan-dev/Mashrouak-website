# Public site origin (set only after the production domain is confirmed)
VITE_SITE_URL=

# Optional overrides; the confirmed public email and WhatsApp number are built in as defaults
VITE_CONTACT_API_URL=
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=

# Optional public analytics identifier; leave empty to keep analytics disabled
VITE_ANALYTICS_ID=
